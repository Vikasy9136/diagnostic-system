{
  "name": "@diagnostic/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript definitions and utilities for Diagnostic Platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./web/LabSetuLogo": "./web/LabSetuLogo.tsx",
    "./web/BankLogo": "./web/BankLogo.tsx",
    "./web/useSeasonalFavicon": "./web/useSeasonalFavicon.ts",
    "./native/BankLogo": "./native/BankLogo.tsx",
    "./assets/brand/*": "./assets/brand/*",
    "./assets/banks/*": "./assets/banks/*"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
