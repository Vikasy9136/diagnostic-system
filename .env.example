# ==============================================================================
# HEALTHCARE DIAGNOSTIC SAMPLE PICKUP & LOGISTICS PLATFORM
# Environment Variables Template
#
# NOTE: Copy this file to .env before running locally.
# DO NOT COMMIT REAL API KEYS, SECRETS, OR SERVICE ACCOUNT CREDENTIALS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Common Settings
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Node.js Backend API (apps/api)
# ------------------------------------------------------------------------------
PORT=5000
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Firebase Admin SDK Configuration (for Backend API)
# Download serviceAccountKey.json from:
# https://console.firebase.google.com/project/labsetu-diagnostics/settings/serviceaccounts/adminsdk
FIREBASE_PROJECT_ID=labsetu-diagnostics
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@labsetu-diagnostics.iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=labsetu-diagnostics.firebasestorage.app

# Platform Admin & Email Notifications (SMTP via Gmail App Password)
ADMIN_EMAIL=lab.setu.admin@gmail.com
ADMIN_INITIAL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=lab.setu.admin@gmail.com
SMTP_PASS=
NOTIFICATION_FROM_EMAIL="LabSetu Diagnostics <lab.setu.admin@gmail.com>"

# ------------------------------------------------------------------------------
# 3. Client Web Apps (Vite / React.js)
# Small Lab Web: apps/web/small-lab (Port 3000)
# Large Partner Lab Web: apps/web/large-lab (Port 3001)
# Admin Dashboard Web: apps/web/admin (Port 3002)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyYourWebApiKey
VITE_FIREBASE_AUTH_DOMAIN=labsetu-diagnostics.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=labsetu-diagnostics
VITE_FIREBASE_STORAGE_BUCKET=labsetu-diagnostics.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=125622512041
VITE_FIREBASE_APP_ID=1:125622512041:web:6484db0479d7d4474cbcb8
VITE_FIREBASE_MEASUREMENT_ID=G-3K3CJZ8590
VITE_API_URL=http://localhost:5000/api/v1
VITE_ADMIN_EMAIL=lab.setu.admin@gmail.com
VITE_USE_FIREBASE_EMULATOR=false

# ------------------------------------------------------------------------------
# 4. Phlebotomist Mobile App (apps/phlebo-app) - Expo / React Native
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourWebApiKey
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=labsetu-diagnostics.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=labsetu-diagnostics
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=labsetu-diagnostics.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=125622512041
EXPO_PUBLIC_FIREBASE_APP_ID=1:125622512041:android:5b37da8831aecea14cbcb8
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1
