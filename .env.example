# ==============================================================================
# HEALTHCARE DIAGNOSTIC SAMPLE PICKUP & LOGISTICS PLATFORM
# Environment Variables Template
#
# NOTE: Copy this file to .env before running locally.
# DO NOT COMMIT REAL API KEYS, SECRETS, OR SERVICE ACCOUNT CREDENTIALS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Common Settings
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Node.js Backend API (apps/api)
# ------------------------------------------------------------------------------
PORT=5000
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Firebase Admin SDK Configuration (for Backend API)
# In production, provide the service account JSON or environment variables
FIREBASE_PROJECT_ID=sample-logistics-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-dummy@sample-logistics-dev.iam.gserviceaccount.com
# Use path to service account json key file or set escaped private key:
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Firebase Cloud Storage (private bucket for test reports & chain-of-custody documents)
FIREBASE_STORAGE_BUCKET=sample-logistics-dev.appspot.com

# ------------------------------------------------------------------------------
# 3. Client Web Apps (Vite / React.js)
# Small Lab Web: apps/web/small-lab (Port 3000)
# Large Partner Lab Web: apps/web/large-lab (Port 3001)
# Admin Dashboard Web: apps/web/admin (Port 3002)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderKey-NotReal123456789
VITE_FIREBASE_AUTH_DOMAIN=sample-logistics-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sample-logistics-dev
VITE_FIREBASE_STORAGE_BUCKET=sample-logistics-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# 4. Phlebotomist Mobile App (apps/phlebo-app) - Expo / React Native
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyPlaceholderKey-NotReal123456789
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=sample-logistics-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sample-logistics-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=sample-logistics-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:android:abcdef1234567890
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1

