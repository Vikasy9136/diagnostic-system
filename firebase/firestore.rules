rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & DUAL RBAC (CUSTOM CLAIMS + ADMIN-PROVISIONED DIRECTORY)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function normalizedEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    function hasDirectoryEntry() {
      return isAuthenticated()
        && normalizedEmail() != ''
        && exists(/databases/$(database)/documents/user_directory/$(normalizedEmail()));
    }

    function directoryEntry() {
      return get(/databases/$(database)/documents/user_directory/$(normalizedEmail())).data;
    }

    function isDirectoryActive() {
      return hasDirectoryEntry() && directoryEntry().isActive != false;
    }

    function getUserRole() {
      return isAuthenticated()
        ? (
            request.auth.token.role != null
              ? request.auth.token.role
              : (isDirectoryActive() ? directoryEntry().role : null)
          )
        : null;
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          normalizedEmail() == 'lab.setu.admin@gmail.com'
          || request.auth.token.role == 'ADMIN'
          || (isDirectoryActive() && directoryEntry().role == 'ADMIN')
        );
    }

    function isSmallLab() {
      return isAuthenticated() && getUserRole() == 'SMALL_LAB';
    }

    function isLargeLab() {
      return isAuthenticated() && getUserRole() == 'LARGE_LAB';
    }

    function isPhlebotomist() {
      return isAuthenticated() && getUserRole() == 'PHLEBOTOMIST';
    }

    function getLabId() {
      return request.auth.token.labId != null
        ? request.auth.token.labId
        : (isDirectoryActive() ? directoryEntry().get('labId', null) : null);
    }

    function getParentLabId() {
      return request.auth.token.parentLabId != null
        ? request.auth.token.parentLabId
        : (isDirectoryActive() ? directoryEntry().get('parentLabId', null) : null);
    }

    function getPhlebotomistId() {
      return request.auth.token.phlebotomistId != null
        ? request.auth.token.phlebotomistId
        : (isDirectoryActive() ? directoryEntry().get('phlebotomistId', null) : null);
    }

    // =========================================================================
    // 1. USERS & ADMIN DIRECTORY (`users/{userId}`, `user_directory/{emailId}`)
    // Strictly Admin-provisioned! Non-admins cannot self-assign or escalate roles.
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'lastLoginAt', 'updatedAt']));
    }

    match /user_directory/{emailId} {
      allow read: if isAdmin()
        || (isAuthenticated() && normalizedEmail() == emailId);
      allow write: if isAdmin();
    }

    match /email_otps/{emailId} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. REGISTERED LABS DIRECTORY (`labs/{labId}`)
    // =========================================================================
    match /labs/{labId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
        || (isLargeLab()
          && request.resource.data.get('parentLabId', null) == getLabId()
          && request.resource.data.type == 'LARGE_LAB'
          && request.resource.data.get('centerType', '') == 'COLLECTION_CENTER');
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuthenticated()
          && (isSmallLab() || isLargeLab())
          && (getLabId() == labId || (isLargeLab() && resource.data.get('parentLabId', null) == getLabId()))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'verificationStatus', 'type']));
    }

    // =========================================================================
    // 3. PHLEBOTOMISTS FLEET (`phlebotomists/{phleboId}`)
    // =========================================================================
    match /phlebotomists/{phleboId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isPhlebotomist()
          && (getPhlebotomistId() == phleboId || resource.data.email == normalizedEmail()));
    }

    // =========================================================================
    // 4. PATIENTS REGISTRY (`patients/{patientId}`)
    // =========================================================================
    match /patients/{patientId} {
      allow read: if isAdmin()
        || isLargeLab()
        || (isSmallLab() && (resource.data.smallLabId == getLabId() || getLabId() == null));
      allow create: if isAdmin()
        || (isSmallLab() && (request.resource.data.smallLabId == getLabId() || getLabId() == null));
      allow update: if isAdmin()
        || (isSmallLab() && (resource.data.smallLabId == getLabId() || getLabId() == null));
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. DIAGNOSTIC TEST CATALOGUE & TARIFFS (`test_catalog/{testId}`)
    // =========================================================================
    match /test_catalog/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isLargeLab();
    }

    // =========================================================================
    // 6. PICKUP ORDERS (`orders/{orderId}`)
    // =========================================================================
    match /orders/{orderId} {
      allow read, write: if isAdmin();

      // Small Labs create bookings, track them, cancel before pickup, AND run QC/reports on SELF_DROP orders
      allow create: if isSmallLab()
        && (request.resource.data.smallLabId == getLabId() || getLabId() == null);
      allow read: if isSmallLab()
        && (
          resource.data.smallLabId == getLabId()
          || resource.data.targetLabId == getLabId()
          || getLabId() == null
        );
      allow update: if isSmallLab()
        && (
          (
            (resource.data.smallLabId == getLabId() || getLabId() == null)
            && resource.data.status in ['CREATED', 'READY_FOR_PICKUP', 'ASSIGNED_TO_PHLEBO']
            && request.resource.data.status in ['READY_FOR_PICKUP', 'CANCELLED']
          )
          || (
            resource.data.targetLabId == getLabId()
            && request.resource.data.status in ['DELIVERED_TO_LAB', 'UNDER_ANALYSIS', 'REPORT_UPLOADED', 'COMPLETED', 'REJECTED']
          )
        );

      // Large Partner Labs (Branch center sees targetLabId == labId; Main HQ also sees child targetParentLabId == labId)
      allow read: if isLargeLab()
        && (
          resource.data.targetLabId == getLabId()
          || resource.data.get('targetParentLabId', null) == getLabId()
          || getLabId() == null
        );
      allow update: if isLargeLab()
        && (
          resource.data.targetLabId == getLabId()
          || resource.data.get('targetParentLabId', null) == getLabId()
          || getLabId() == null
        )
        && request.resource.data.status in ['DELIVERED_TO_LAB', 'UNDER_ANALYSIS', 'REPORT_UPLOADED', 'COMPLETED', 'REJECTED'];

      // Field Phlebotomists read assigned orders or open dispatch pool, accept/collect/deliver
      allow read: if isPhlebotomist()
        && (
          resource.data.phlebotomistId == getPhlebotomistId()
          || (resource.data.status == 'READY_FOR_PICKUP' && (resource.data.phlebotomistId == null || resource.data.phlebotomistId == ''))
        );
      allow update: if isPhlebotomist()
        && (
          resource.data.phlebotomistId == getPhlebotomistId()
          || (
            resource.data.status == 'READY_FOR_PICKUP'
            && (resource.data.phlebotomistId == null || resource.data.phlebotomistId == '')
            && request.resource.data.phlebotomistId == getPhlebotomistId()
          )
        )
        && request.resource.data.status in ['READY_FOR_PICKUP', 'ASSIGNED_TO_PHLEBO', 'PICKED_UP', 'IN_TRANSIT', 'DELIVERED_TO_LAB'];
    }

    // =========================================================================
    // 7. DIAGNOSTIC REPORTS METADATA (`reports/{reportId}`)
    // =========================================================================
    match /reports/{reportId} {
      allow read: if isAdmin()
        || (isSmallLab() && (
          resource.data.smallLabId == getLabId()
          || resource.data.targetLabId == getLabId()
          || getLabId() == null
        ))
        || (isLargeLab() && (
          resource.data.targetLabId == getLabId()
          || resource.data.get('targetParentLabId', null) == getLabId()
          || getLabId() == null
        ));
      allow create, update: if isAdmin()
        || (isLargeLab() && (
          request.resource.data.targetLabId == getLabId()
          || request.resource.data.get('targetParentLabId', null) == getLabId()
          || getLabId() == null
        ))
        || (isSmallLab() && request.resource.data.targetLabId == getLabId());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 8. BILLING & SETTLEMENTS LEDGER (`settlements/{settlementId}`)
    // =========================================================================
    match /settlements/{settlementId} {
      allow read: if isAdmin()
        || (isSmallLab() && (resource.data.smallLabId == getLabId() || getLabId() == null))
        || (isLargeLab() && (
          resource.data.targetLabId == getLabId()
          || resource.data.get('targetParentLabId', null) == getLabId()
          || getLabId() == null
        ))
        || (isPhlebotomist() && resource.data.phlebotomistId == getPhlebotomistId());
      allow create: if isAdmin()
        || ((isSmallLab() || isLargeLab())
          && request.resource.data.status == 'PENDING'
          && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == 'UNPAID'));
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 8B. PARTNER PAYOUTS LEDGER (`payouts/{payoutId}`) - SERVER WRITTEN ONLY
    // =========================================================================
    match /payouts/{payoutId} {
      allow read: if isAdmin()
        || (isLargeLab() && resource.data.recipientRole == 'LARGE_LAB' && (resource.data.recipientId == getLabId() || getLabId() == null))
        || (isPhlebotomist() && resource.data.recipientRole == 'PHLEBOTOMIST' && resource.data.recipientId == getPhlebotomistId());
      allow write: if false;
    }

    // =========================================================================
    // 9. IMMUTABLE CHAIN-OF-CUSTODY AUDIT EVENTS (`custody_events/{eventId}`)
    // =========================================================================
    match /custody_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.operatorId == request.auth.uid;
      allow update, delete: if false;
    }

    // =========================================================================
    // 10. PLATFORM & EMAIL NOTIFICATIONS (`notifications/{notificationId}`)
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && (
          resource.data.recipientUid == request.auth.uid
          || resource.data.recipientEmail == normalizedEmail()
          || resource.data.recipientRole == getUserRole()
          || resource.data.recipientRole == 'ALL'
        ));
      allow create: if isAuthenticated();
      allow update: if isAdmin()
        || (isAuthenticated() && (
          resource.data.recipientUid == request.auth.uid
          || resource.data.recipientEmail == normalizedEmail()
          || resource.data.recipientRole == getUserRole()
        ));
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 11. EMAIL DELIVERY QUEUE / AUDIT LOG (`mail/{mailId}`)
    // =========================================================================
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 12. PLATFORM GLOBAL SETTINGS (`settings/{settingId}`)
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
