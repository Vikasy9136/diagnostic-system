{
  "name": "labsetu-firebase-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase Cloud Functions Gen 2 backend for LabSetu Diagnostics Network",
  "engines": {
    "node": "22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --project labsetu-diagnostics --config ../firebase.json",
    "logs": "firebase functions:log --project labsetu-diagnostics --config ../firebase.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^6.0.1",
    "helmet": "^7.1.0",
    "nodemailer": "^10.4.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
