rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          request.auth.token.role == 'ADMIN'
          || request.auth.token.email == 'lab.setu.admin@gmail.com'
        );
    }

    // Diagnostic Reports: reports/{orderId}/{fileName}
    match /reports/{orderId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.token.role == 'LARGE_LAB');
    }

    // Custody Handover Digital Signatures: signatures/{orderId}/{fileName}
    match /signatures/{orderId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.token.role in ['PHLEBOTOMIST', 'SMALL_LAB', 'ADMIN'] || isAdmin());
    }

    // Lab Verification & Compliance KYC Documents: documents/{labId}/{fileName}
    match /documents/{labId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || request.auth.token.labId == labId);
    }

    // Deny all other unrestricted access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
