{
  "name": "diagnostic-platform-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Healthcare Diagnostic Sample Pickup and Logistics Platform",
  "workspaces": [
    "packages/*",
    "apps/web/*",
    "apps/api",
    "apps/phlebo-app"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs --all",
    "dev:api": "npm --workspace=@diagnostic/api run dev",
    "dev:portal": "npm --workspace=@diagnostic/portal run dev",
    "dev:small-lab": "npm --workspace=@diagnostic/small-lab run dev",
    "dev:large-lab": "npm --workspace=@diagnostic/large-lab run dev",
    "dev:admin": "npm --workspace=@diagnostic/admin run dev",
    "dev:phlebo": "npm --workspace=@diagnostic/phlebo-app run start",
    "build:shared": "npm --workspace=@diagnostic/shared run build",
    "build:api": "npm --workspace=@diagnostic/api run build",
    "build:functions": "npm --prefix firebase/functions run build",
    "build:web": "npm run build --workspaces --if-present",
    "build:all": "npm run build:shared && npm run build:api && npm run build:web && npm run build:functions",
    "seed:firebase": "npm --workspace=@diagnostic/api run seed:firebase",
    "firebase:deploy": "npm run build:shared && npm --workspace=@diagnostic/portal run build && npm run build:functions && node scripts/deploy-firebase.mjs",
    "firebase:deploy:rules": "firebase deploy --only firestore,storage --project labsetu-diagnostics --config firebase/firebase.json",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "healthcare",
    "diagnostics",
    "logistics",
    "phlebotomy",
    "cold-chain",
    "firebase"
  ],
  "author": "Vikas",
  "license": "UNLICENSED"
}

